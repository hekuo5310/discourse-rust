{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forum-engine",
  "main": "apps/worker/build/worker/shim.mjs",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "cargo install -q \"worker-build@^0.8\" && cd apps/worker && worker-build --release"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forum-engine-db",
      "migrations_dir": "migrations/d1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
